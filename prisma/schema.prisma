generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PROVIDER
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
}

enum CreditTransactionType {
  CHARGE
  PAYMENT
}

model Account {
  id           String   @id @default(cuid())
  role         Role
  email        String   @unique
  passwordHash String
  name         String?
  staffOfId    String?
  staffOf      Provider? @relation("StaffAccounts", fields: [staffOfId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     Provider?
}

model Provider {
  id                    String         @id @default(cuid())
  account               Account        @relation(fields: [accountId], references: [id])
  accountId             String         @unique
  businessName          String
  ownerName             String
  status                ProviderStatus @default(ACTIVE)
  // The WhatsApp Cloud API "Phone Number ID" this business has connected —
  // one Meta app/access token serves every provider on the platform, and
  // an incoming webhook is routed to the right provider by this field.
  whatsappPhoneNumberId String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  staffAccounts    Account[]         @relation("StaffAccounts")
  inventory        InventoryItem[]
  customers        Customer[]
  sales            Sale[]
  branches         Branch[]
  whatsAppSessions WhatsAppSession[]
}

model Branch {
  id         String   @id @default(cuid())
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId String
  name       String
  address    String?
  createdAt  DateTime @default(now())

  inventory InventoryItem[]
  sales     Sale[]
}

model InventoryItem {
  id         String     @id @default(cuid())
  provider   Provider   @relation(fields: [providerId], references: [id])
  providerId String
  branch     Branch?    @relation(fields: [branchId], references: [id])
  branchId   String?
  name       String
  category   String
  price      Decimal
  stock      Int        @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  saleItems  SaleItem[]
}

model Customer {
  id                 String              @id @default(cuid())
  provider           Provider            @relation(fields: [providerId], references: [id])
  providerId         String
  name               String
  phone              String
  creditBalance      Decimal             @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())

  sales              Sale[]
  creditTransactions CreditTransaction[]
}

model CreditTransaction {
  id         String                @id @default(cuid())
  customer   Customer              @relation(fields: [customerId], references: [id])
  customerId String
  type       CreditTransactionType
  amount     Decimal
  note       String?
  createdAt  DateTime              @default(now())
}

model Sale {
  id         String     @id @default(cuid())
  provider   Provider   @relation(fields: [providerId], references: [id])
  providerId String
  branch     Branch?    @relation(fields: [branchId], references: [id])
  branchId   String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  customerId String?
  isCredit   Boolean    @default(false)
  subtotal   Decimal
  tax        Decimal
  total      Decimal
  createdAt  DateTime   @default(now())

  items      SaleItem[]
}

model SaleItem {
  id              String        @id @default(cuid())
  sale            Sale          @relation(fields: [saleId], references: [id])
  saleId          String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  name            String
  price           Decimal
  qty             Int
}

// One row per (provider, customer phone number) — holds the in-progress cart
// and recent chat history for the WhatsApp order assistant, since each
// incoming message is a separate, stateless webhook request.
model WhatsAppSession {
  id            String   @id @default(cuid())
  provider      Provider @relation(fields: [providerId], references: [id])
  providerId    String
  customerPhone String
  cart          Json     @default("[]")
  history       Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([providerId, customerPhone])
}